{
  "name": "gokball",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "https://gokball.vercel.app,https://gokball.gokayaktas10.workers.dev"
  },
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/admin/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SERVER",
        "class_name": "GameServerDurableObject"
      }
    ]
  },
  "exports": {
    "GameServerDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
